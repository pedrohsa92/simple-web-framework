{
  "name": "phsa/simple-web-framework",
  "description": "Framework modular em PHP para aplicações web",
  "minimum-stability": "stable",
  "authors": [
    {
      "name": "Pedro HSA",
      "email": "pedro.hsa92@gmail.com",
      "homepage": "https://www.phsa.com.br",
      "role": "Developer"
    }
  ],
  "config": {
    "vendor-dir": "vendor"
  },
  "autoload": {
    "psr-4": {
      "Source\\": "source/"
    },
    "files": [
      "source/Engine/Helpers.php",
      "source/Phpmailer/Phpmailer.php"
    ]
  },
  "require": {
    "php": "^8.0",
    "phpmailer/phpmailer": "^6.9",
    "league/plates": "v3.x-dev",
    "matthiasmullie/minify": "^1.3",
    "vlucas/phpdotenv": "^5.6"
  }
}
